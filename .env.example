# ---- Server ----
PORT=4000
# Secret used to sign access & refresh tokens. Change in production.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (seconds)
ACCESS_TOKEN_TTL=900
# Refresh token lifetime (seconds)
REFRESH_TOKEN_TTL=2592000
# Storage: pglite (embedded PostgreSQL, zero-config) or postgres (production)
DB_DRIVER=pglite
# Only used when DB_DRIVER=postgres
DATABASE_URL=postgres://user:password@localhost:5432/pathshala
# Local file storage directory for uploads
UPLOAD_DIR=./uploads
# Public base URL used in links / exports
PUBLIC_URL=http://localhost:4000

# ---- Web ----
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ---- Optional integrations (configure per school) ----
# SMS gateway (e.g. Sparrow SMS / NTC / NCell aggregator)
SMS_API_URL=
SMS_API_KEY=
# Push notifications (web push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Payment gateways
ESEWA_MERCHANT_ID=
KHALTI_PUBLIC_KEY=
FONEPAY_MERCHANT_ID=
# AI assistant provider
AI_API_KEY=
AI_API_MODEL=
